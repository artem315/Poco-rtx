#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_GOOGLE_include_directive : require

// Kernel 3/3: reflections on smooth materials, metals and puddles, and on water, glass and
// ice in front of them, plus sun/moon highlights. Output: light to add (reflection already
// weighted, highlights) and the reflection weight.

layout(local_size_x = 8, local_size_y = 8) in;

#include "rt_common.glsl"
#include "rt_shared.glsl"

layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D oRefl;
layout(set = 0, binding = 9) uniform sampler2D gNormal;
layout(set = 0, binding = 10) uniform sampler2D gAlbedo;
layout(set = 0, binding = 11) uniform sampler2D gInfo;

layout(set = 0, binding = 12) uniform sampler2D uLight;   // this frame's light output (sun visibility in g)

// A surface seen in a reflection, lit like the rasterised world is by the composite.
vec3 shadeReflected(Hit h, vec3 d, bool shadowRay, inout Rng rng) {
    float lod = clamp(log2(max(h.t, 1.0) * 0.05), 0.0, 3.0);
    vec4 tex = textureLod(uAtlas, h.uv, lod);
    Material m = material(h.uv);
    vec3 pos = d * h.t;
    float vis = 0.0;
    if (F.light.w > 0.001 && dot(h.n, F.light.xyz) > 0.0) {
        vis = shadowRay ? (traceAny(pos + h.n * 0.02, lightSample(rng), F.params.x, MASK_OPAQUE, false) ? 0.0 : 1.0)
                        : guessVisibility(h.lm);
    }
    float glow = m.emissive * F.params2.z * (m.id == MAT_GLOW_PARTIAL ? smoothstep(0.55, 0.85, luma(tex.rgb)) : 1.0) * 1.5;
    return shadeHit(h, tex.rgb, vis, glow, true);
}

void main() {
    Pixel px;
    if (!setupPixel(px)) {
        return;
    }
    vec4 outRefl = vec4(0.0);
    float roughness = 1.0;
    bool submerged = F.params3.w > 0.5;
    bool alphaTest = F.params.w > 0.5;
    bool reflShadows = F.quality.y > 0.5;
    if (!px.sky && !submerged) {
        Rng rng = makeRng(px.pix, 3u);
        Surface s = readSurface(px, gNormal, gAlbedo, gInfo);
        vec3 v = -px.viewDir;
        vec3 add = vec3(0.0);
        // One reflection ray per pixel: from water/glass in front when there is one, else
        // from a smooth opaque surface.
        bool reflectRay = false;
        vec3 ro = vec3(0.0), rd = vec3(0.0, 1.0, 0.0), tint = vec3(1.0);
        float weight = 0.0, skyOpen = 0.0;
        uint mask = MASK_OPAQUE;

        if (px.fd > px.od + 1e-7) {
            // Water, glass and ice in front of the opaque surface.
            vec3 pf = worldPos(px.uv, px.fd);
            float df = length(pf);
            Hit th = traceClosest(vec3(0.0), pf / df, df * 1.02 + 0.3, MASK_TRANSLUCENT, true);
            vec3 ng;
            int id = MAT_WATER;
            vec2 lm = vec2(0.0, 1.0);
            if (th.hit && abs(th.t - df) < max(0.1, df * 0.015)) {
                pf = (pf / df) * th.t;
                ng = th.n;
                Material tm = material(th.uv);
                id = tm.id == MAT_DEFAULT ? MAT_GLASS : tm.id;
                lm = th.lm;
            } else {
                ng = depthNormal(px.fullPix, pf, true);
            }
            vec3 n = id == MAT_WATER ? waterNormal(F.camera.xyz + pf, ng) : ng;
            float f = fresnel(id == MAT_WATER ? 0.02 : 0.04, dot(n, v));
            if (F.toggles.w > 0.5) {
                rd = reflect(px.viewDir, n);
                if (dot(rd, ng) < 0.02) {
                    // Waves can tilt the reflection below the surface: mirror on the flat surface instead.
                    rd = reflect(px.viewDir, ng);
                }
                ro = pf + ng * 0.03;
                float fadeF = 1.0 - smoothstep(F.params.x * 0.85, F.params.x * 1.15, df);
                weight = clamp((id == MAT_WATER ? f * 1.4 + 0.04 : f * 0.8) * F.strength.w * mix(0.5, 1.0, fadeF), 0.0, 1.0);
                skyOpen = smoothstep(0.2, 0.9, lm.y);
                reflectRay = true;
            }
            if (F.toggles2.x > 0.5 && F.light.w > 0.001) {
                float vis = traceAny(pf + ng * 0.03, lightSample(rng), F.params.x, MASK_OPAQUE | MASK_ENTITY, false) ? 0.0 : 1.0;
                float spec = ggxSpecular(n, v, F.light.xyz, id == MAT_WATER ? 0.05 : 0.03) * f;
                add += F.lightColor.rgb * (spec * vis * F.light.w * F.params3.z * 1.5);
            }
            roughness = 0.0;
        } else if (s.exact) {
            // Sun/moon highlight.
            float sunlit = texelFetch(uLight, px.pix, 0).g;
            if (F.toggles2.x > 0.5 && F.light.w > 0.001 && sunlit > 0.0 && dot(s.n, F.light.xyz) > 0.0) {
                float f0 = s.mat.metal ? 0.9 : s.mat.f0;
                float spec = ggxSpecular(s.n, v, F.light.xyz, max(s.mat.roughness, 0.06)) * fresnel(f0, dot(normalize(v + F.light.xyz), v));
                vec3 htint = s.mat.metal ? s.albedo : vec3(1.0);
                add += F.lightColor.rgb * htint * (spec * sunlit * F.light.w * F.params3.z * smoothstep(0.03, 0.35, s.lm.y));
            }
            if (F.toggles.w > 0.5 && s.mat.roughness < 0.6) {
                float r = s.mat.roughness;
                vec3 n = r > 0.02 ? normalize(mix(s.n, cosineDir(s.n, rng), r * r)) : s.n;
                rd = reflect(px.viewDir, n);
                if (dot(rd, s.n) < 0.0) {
                    rd = reflect(px.viewDir, s.n);
                }
                ro = s.p + s.n * 0.02;
                float fade = 1.0 - smoothstep(F.params.x * 0.85, F.params.x * 1.15, length(s.p));
                float f = fresnel(s.mat.metal ? 0.7 : s.mat.f0, dot(s.n, v));
                weight = clamp((s.mat.metal ? mix(0.35, 0.85, 1.0 - r) : f * (1.0 - r)) * F.strength.w * fade, 0.0, 1.0);
                tint = s.mat.metal ? s.albedo * 1.4 : vec3(1.0);
                skyOpen = smoothstep(0.3, 0.9, s.lm.y);
                mask = MASK_OPAQUE | MASK_TRANSLUCENT;
                roughness = r;
                reflectRay = true;
            }
        }

        if (reflectRay && weight > 0.002) {
            Hit h = traceClosest(ro, rd, F.params.x, mask, alphaTest);
            vec3 col = h.hit ? shadeReflected(h, rd, reflShadows, rng) : skyRadiance(rd) * skyOpen;
            add += col * tint * weight;
        }
        outRefl = vec4(add, weight);
    }
    vec2 puv;
    float alpha = temporalAlpha(px, puv);
    if (alpha < 1.0) {
        // Sharp reflections move with the view, so they keep less history.
        float reflAlpha = mix(0.6, alpha, clamp(roughness * 2.0, 0.0, 1.0));
        outRefl = mix(textureLod(uHistory, puv, 0.0), outRefl, reflAlpha);
    }
    imageStore(oRefl, px.pix, outRefl);
}
