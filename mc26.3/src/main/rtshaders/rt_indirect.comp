#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_GOOGLE_include_directive : require

// Kernel 2/3: one bounce of diffuse global illumination, including the glow of emissive
// blocks. Output: bounced light arriving at the surface (rgb, lightmap units).

layout(local_size_x = 8, local_size_y = 8) in;

#include "rt_common.glsl"
#include "rt_shared.glsl"

layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D oIndirect;
layout(set = 0, binding = 9) uniform sampler2D gNormal;
layout(set = 0, binding = 10) uniform sampler2D gAlbedo;
layout(set = 0, binding = 11) uniform sampler2D gInfo;
layout(set = 0, binding = 12) uniform sampler2D uLight;   // this frame's light output (sun visibility in g)

// Light a diffuse ray brings back from the surface it hit.
vec3 bounce(Hit h, vec3 d, bool shadowRay, inout Rng rng) {
    vec4 tex = textureLod(uAtlas, h.uv, F.quality.z);
    Material m = material(h.uv);
    vec3 pos = d * h.t;
    float vis = 0.0;
    if (F.light.w > 0.001 && dot(h.n, F.light.xyz) > 0.0) {
        vis = shadowRay ? (traceAny(pos + h.n * 0.02, lightSample(rng), F.params.x, MASK_OPAQUE, false) ? 0.0 : 1.0)
                        : guessVisibility(h.lm);
    }
    float glow = m.emissive * F.params2.z * (m.id == MAT_GLOW_PARTIAL ? smoothstep(0.55, 0.85, luma(tex.rgb)) : 1.0) * 2.0;
    return shadeHit(h, tex.rgb, vis, glow, false);
}

void main() {
    Pixel px;
    if (!setupPixel(px)) {
        return;
    }
    vec3 gi = vec3(0.0);
    if (!px.sky && F.toggles.z > 0.5) {
        Rng rng = makeRng(px.pix, 2u);
        Surface s = readSurface(px, gNormal, gAlbedo, gInfo);
        if (s.mat.id != MAT_NONE) {
            vec3 origin = s.p + s.n * 0.02;
            int n = int(F.counts.y);
            for (int i = 0; i < n; i++) {
                vec3 d = cosineDir(s.n, rng);
                Hit h = traceClosest(origin, d, 24.0, MASK_OPAQUE, false);
                if (h.hit) {
                    gi += bounce(h, d, F.quality.x > 0.5, rng);
                }
            }
            gi /= float(max(n, 1));
        }
    }
    vec2 puv;
    float alpha = temporalAlpha(px, puv);
    if (alpha < 1.0) {
        gi = mix(textureLod(uHistory, puv, 0.0).rgb, gi, alpha);
    }
    imageStore(oIndirect, px.pix, vec4(gi, 1.0));
}
